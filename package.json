    "next": "^15.4.7",
    "next-intl": "^4.3.4",
    "performant-array-to-tree": "^1.11.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-redux": "^9.2.0",
    "swr": "^2.3.6",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.12"
